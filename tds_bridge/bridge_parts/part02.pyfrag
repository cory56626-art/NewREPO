    ms=re.findall(r'-?\d+(?:\.\d+)?',clean(v).replace(',','')); return float(ms[-1]) if ms else None

def conflicts(st):
    out=[]
    def field_for(label):
        s=norm(label)
        if 'damage' in s and 'chill' not in s: return 'damage'
        if s in {'tick','firerate','fire rate'} or ' tick' in s: return 'tick'
        if 'charge-up' in s or 'charge up' in s or 'charge time' in s: return 'charge_up'
        if 'cooldown' in s: return 'cooldown'
        if 'overcharge' in s: return 'overcharge'
        if 'range' in s: return 'range'
        return None
    tables=st.get('statistics_tables',{})
    modes=st.get('upgrade_modes',{})
    for mode in ('regular','pvp'):
        rows={r.get('level'):r for r in tables.get(mode,[])}
        upgrades=modes.get(mode,[])
        for u in upgrades:
            lvl=u.get('level'); row=rows.get(lvl); prev=rows.get((lvl or 0)-1)
            if not row: continue
            uc=num(u.get('cost'))
            if uc is not None and row.get('cost') is not None and abs(uc-row['cost'])>1e-9:
                out.append({'mode':mode,'level':lvl,'field':'cost','upgrade_claim':uc,'statistics_table_claim':row['cost'],'preferred_source':'upgrade_template','type':'cost_mismatch'})
            for cl in u.get('claims',[]):
                fld=field_for(cl.get('stat',''))
                if not fld: continue
                if cl.get('kind')=='set':
                    target=num(cl.get('to')); table=row.get(fld)
                    if target is not None and table is not None and abs(target-table)>1e-9:
                        out.append({'mode':mode,'level':lvl,'field':fld,'upgrade_claim':target,'statistics_table_claim':table,'preferred_source':'upgrade_template','type':'set_mismatch','claim_text':cl.get('text')})
                elif cl.get('kind')=='delta' and prev:
                    delta=num(cl.get('delta')); before=prev.get(fld); table=row.get(fld)
                    if delta is not None and before is not None and table is not None:
                        expected=before+delta
                        if abs(expected-table)>1e-9:
                            out.append({'mode':mode,'level':lvl,'field':fld,'upgrade_implied':expected,'statistics_table_claim':table,'preferred_source':'upgrade_template','type':'delta_mismatch','claim_text':cl.get('text')})
    inf=(st.get('likely_infobox') or {}).get('params',{}); ip={norm(k):v for k,v in inf.items()}
    for mode,prefix in (('regular',''),('pvp','pvp_')):
        rows=tables.get(mode,[])
        if not rows: continue
        base=rows[0]
        pairs=[('damage',prefix+'basedamage'),('tick',prefix+'basefirerate'),('range',prefix+'baserange')]
        for fld,key in pairs:
            iv=num(ip.get(key)); tv=base.get(fld)
            if iv is not None and tv is not None and abs(iv-tv)>1e-9:
                out.append({'mode':mode,'level':0,'field':fld,'infobox_claim':iv,'statistics_table_claim':tv,'preferred_source':'infobox_or_description_only_if_no_upgrade_claim','type':'base_summary_mismatch'})
    return {'priority_rule':PRIORITY,'potential_conflicts':out,'notes':['Different upgrade levels can legitimately differ.','When a current-level Upgrade claim disagrees with the Statistics table, the configured rule prefers Upgrade/Description and flags the mismatch rather than silently choosing.']}

def classify(wt,cats,tpls):
    c=[norm(x.get('title') if isinstance(x,dict) else x) for x in cats]; t=[norm(x.get('title') if isinstance(x,dict) else x) for x in tpls]
    ok=any('tower' in x and 'infobox' in x for x in t) or any(x.endswith(':towers') or ' tower' in x for x in c) or '{{towerinfobox' in norm(wt)
    return {'is_tower_page':bool(ok),'reason':'template/category heuristic'}

def related_candidates(query,links,limit=12):
    kws=['buff','debuff','enemy','ability','detection','defense','firerate','damage','range','hidden','flying','lead','stun','freeze']; qtok=[x for x in re.findall(r'[a-z0-9]+',norm(query)) if len(x)>2]
    scored=[]
    for it in links:
        title=(it.get('*') or it.get('title')) if isinstance(it,dict) else str(it)
        if not title or title.startswith(('File:','Category:','Template:')): continue
        low=norm(title); score=sum(3 for x in qtok if x in low)+sum(1 for x in kws if x in low)
        if score: scored.append((score,title))
    scored.sort(key=lambda x:(-x[0],x[1])); seen=set(); out=[]
    for score,title in scored:
        if title in seen: continue
        seen.add(title); out.append({'title':title,'score':score})
        if len(out)>=limit: break
    return out

def fetch_related(items):
    out=[]
    for it in items:
        try:
            p,r,w=page_bundle(it['title']); out.append({'title':it['title'],'score':it['score'],'pageid':p.get('pageid'),'latest_revid':r[0].get('revid') if r else None,'latest_timestamp':r[0].get('timestamp') if r else None,'wikitext_excerpt':w[:4000]})
        except Exception as e: out.append({'title':it['title'],'score':it['score'],'error':str(e)})
    return out

def track(title):
    p=ROOT/'tracked_pages.json'; d={'pages':[]}
    if p.exists():
        try:d=json.loads(p.read_text())
        except:pass
    pages=set(d.get('pages',[])); pages.add(title); wjson('tracked_pages.json',{'pages':sorted(pages)})

def verify(q):
    res=resolve_title(q); wjson('resolution.json',res)
    if res['status']!='resolved':
        wjson('search_candidates.json',res.get('candidates',[])); wjson('meta.json',{'mode':'verify','status':'needs_selection','requested':q}); wjson('evidence_bundle.json',{'mode':'verify','requested':q,'resolution':res,'warning':'No fuzzy result auto-selected.'}); return 2
    title=res['canonical_title']; p,revs,wt=page_bundle(title); pm=parse_meta(title); pwt=pm.get('wikitext'); wt=(pwt.get('*') if isinstance(pwt,dict) else pwt) or wt
    cats=p.get('categories',[]) or pm.get('categories',[]); links=pm.get('links',[]); tpls=pm.get('templates',[]); backs=backlinks(title)
    st=structured(wt); cf=conflicts(st); df=diff_of(revs); ex=expand(title,wt); rel=fetch_related(related_candidates(q,links)); cls=classify(wt,cats,tpls)
    hist=[{k:r.get(k) for k in ('revid','parentid','timestamp','user','comment','size','sha1')} for r in revs]
    meta={'mode':'verify','requested':q,'title':title,'pageid':p.get('pageid'),'latest_revid':hist[0]['revid'] if hist else None,'latest_timestamp':hist[0]['timestamp'] if hist else None,'source_url':BASE+'/wiki/'+urllib.parse.quote(title.replace(' ','_')),'classification':cls,'source_priority':PRIORITY}
    wtext('result.txt',wt); wjson('meta.json',meta); wjson('revision_history.json',hist); wjson('revision_diff.json',df); wjson('categories.json',cats); wjson('backlinks.json',backs); wjson('templates.json',tpls); wtext('expanded_wikitext.txt',ex); wjson('structured_stats.json',st); wjson('conflicts.json',cf); wjson('related_pages.json',rel); wjson('search_candidates.json',[]); track(title)
    wjson('evidence_bundle.json',{'meta':meta,'resolution':res,'revision_history':hist,'revision_diff':df,'classification':cls,'structured_stats':st,'conflicts':cf,'categories':cats,'backlinks':backs,'templates':tpls,'related_pages':rel,'raw_wikitext_file':'tds_bridge/result.txt','expanded_wikitext_file':'tds_bridge/expanded_wikitext.txt'})
    return 0

def history(q):
    res=resolve_title(q); wjson('resolution.json',res)
