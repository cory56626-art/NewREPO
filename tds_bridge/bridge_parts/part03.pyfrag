    if res['status']!='resolved': wjson('search_candidates.json',res.get('candidates',[])); return 2
    p,revs,_=page_bundle(res['canonical_title']); hist=[{k:r.get(k) for k in ('revid','parentid','timestamp','user','comment','size','sha1')} for r in revs]; df=diff_of(revs)
    wjson('revision_history.json',hist); wjson('revision_diff.json',df); wjson('meta.json',{'mode':'history','requested':q,'title':res['canonical_title'],'pageid':p.get('pageid')}); wjson('evidence_bundle.json',{'mode':'history','resolution':res,'revision_history':hist,'revision_diff':df}); return 0

def search_mode(q):
    alias=ALIASES.get(norm(q)); cs=search_candidates(alias or q,12); out=[]
    for c in cs:
        c=dict(c)
        try:
            p,_,wt=page_bundle(c['title']); pm=parse_meta(c['title']); c['classification']=classify(wt,p.get('categories',[]),pm.get('templates',[]))
        except Exception as e:c['validation_error']=str(e)
        out.append(c)
    wjson('search_candidates.json',out); wjson('meta.json',{'mode':'search','requested':q,'known_alias_target':alias,'selection_policy':'No fuzzy candidate is ever auto-selected.'}); wjson('evidence_bundle.json',{'mode':'search','requested':q,'known_alias_target':alias,'candidates':out}); return 0

def collect(obj,depth=0):
    if depth>14:return []
    out=[]
    if isinstance(obj,dict):
        for k,v in obj.items():
            if norm(k) in {'title','rawcontent','content','text','username','name','id','threadid'} and isinstance(v,(str,int,float)): out.append(f'{k}: {v}')
            else: out+=collect(v,depth+1)
    elif isinstance(obj,list):
        for v in obj: out+=collect(v,depth+1)
    return out

def discussion(url):
    m=re.search(r'/f/p/(\d+)',url or '')
    if not m: raise ValueError('thread_url must contain /f/p/<threadId>')
    tid=m.group(1); d=get_json(WIKIA,{'controller':'DiscussionThread','method':'getThread','threadId':tid,'limit':100,'responseGroup':'full','sortDirection':'ascending','sortKey':'creation_date','viewableOnly':'false'})
    wtext('discussion_json.txt',json.dumps(d,ensure_ascii=False,indent=2)); wtext('discussion_text.txt','\n'.join(collect(d))); wjson('meta.json',{'mode':'discussion','thread_url':url,'thread_id':tid}); wjson('evidence_bundle.json',{'mode':'discussion','thread_url':url,'thread_id':tid,'discussion':d}); return 0

def flatten(obj,out=None,depth=0):
    out=[] if out is None else out
    if depth>12:return out
    if isinstance(obj,dict):
        tf=[v for k,v in obj.items() if norm(k) in {'title','rawcontent','content','text','body'} and isinstance(v,str)]
        if tf and any(k in obj for k in ('id','threadId','threadIdStr','title')): out.append(obj)
        for v in obj.values(): flatten(v,out,depth+1)
    elif isinstance(obj,list):
        for v in obj: flatten(v,out,depth+1)
    return out

def discussion_search(q,limit=100):
    try:d=get_json(WIKIA,{'controller':'DiscussionThread','method':'getThreads','siteId':SITE_ID,'limit':min(max(limit,1),100),'responseGroup':'full','sortDirection':'descending','sortKey':'creation_date','viewableOnly':'false'})
    except Exception as e:
        r={'query':q,'error':str(e),'matches':[],'scope':'recent discussions endpoint'}; wjson('discussion_search.json',r); wjson('meta.json',{'mode':'discussion_search','requested':q,'status':'endpoint_error'}); wjson('evidence_bundle.json',{'mode':'discussion_search',**r}); return 1
    wjson('discussion_recent_raw.json',d)
    toks=[t for t in re.findall(r'[a-z0-9]+',norm(q)) if len(t)>1]; matches=[]; seen=set()
    for o in flatten(d):
        blob=' '.join(str(o.get(k,'')) for k in ('title','rawContent','content','text','body')); low=norm(blob); score=sum(low.count(t) for t in toks)
        if not score: continue
        tid=o.get('threadId') or o.get('threadIdStr') or o.get('id'); key=str(tid)+'|'+str(o.get('title'))
        if key in seen: continue
        seen.add(key); matches.append({'score':score,'thread_id':tid,'title':o.get('title'),'author':o.get('createdBy') or o.get('username') or o.get('user'),'snippet':strip_html(blob)[:700],'url':f'{BASE}/f/p/{tid}' if str(tid).isdigit() else None})
    matches.sort(key=lambda x:(-x['score'],str(x.get('title') or ''))); r={'query':q,'scope':f'latest {min(max(limit,1),100)} discussions returned by Fandom getThreads','warning':'Not an unlimited historical full-text index; searches the discussions Fandom returned.','matches':matches[:30]}
    wjson('discussion_search.json',r); wjson('meta.json',{'mode':'discussion_search','requested':q,'match_count':len(r['matches'])}); wjson('evidence_bundle.json',{'mode':'discussion_search',**r}); return 0


def _deep_blob(o):
    # Include nested text too (poll answers, attachment captions, etc.).
    vals=[]
    wanted={'title','rawcontent','content','text','body','description','question','caption','alt','label'}
    def rec(x,depth=0):
        if depth>12:return
        if isinstance(x,dict):
            for k,v in x.items():
                if norm(k) in wanted and isinstance(v,str): vals.append(v)
                else: rec(v,depth+1)
        elif isinstance(x,list):
            for v in x: rec(v,depth+1)
    rec(o)
    return ' '.join(vals)

def _media_info(o):
    # Surface image-bearing discussion posts so screenshot-only loadouts are not filtered out.
    urls=[]; seen=set()
    def rec(x,depth=0):
        if depth>12:return
        if isinstance(x,dict):
            u=x.get('url'); mt=str(x.get('mediaType') or '').lower()
            if isinstance(u,str) and u and (mt.startswith('image/') or 'static.wikia' in u):
                if u not in seen:
                    seen.add(u); urls.append(u)
            for v in x.values(): rec(v,depth+1)
        elif isinstance(x,list):
            for v in x: rec(v,depth+1)
    rec(o)
    return {'has_images':bool(urls),'image_urls':urls[:12]}

def _group_hit(low, group):
    if isinstance(group,str): group=[group]
    return any(norm(alias) in low for alias in group if str(alias).strip())

_LOADOUT_TOWER_ALIASES=[
    ('Golden Minigunner',['golden minigunner','golden mini','gmini']),
    ('Golden Crook Boss',['golden crook boss','golden crook','gcrook']),
    ('Golden Pyromancer',['golden pyromancer','golden pyro','gpyro']),
    ('Golden Demoman',['golden demoman','golden demo','gdemo']),
    ('Golden Soldier',['golden soldier','gsoldier']),
    ('Golden Cowboy',['golden cowboy','gcow']),
    ('Golden Scout',['golden scout','gscout']),
    ('Mercenary Base',['mercenary base','merc base']),
    ('Military Base',['military base']),
    ('DJ Booth',['dj booth','dj']),
    ('Crook Boss',['crook boss']),
    ('Ace Pilot',['ace pilot']),
    ('Gatling Gun',['gatling gun']),
    ('Elf Camp',['elf camp']),
    ('Frost Blaster',['frost blaster']),
    ('Toxic Gunner',['toxic gunner']),
    ('Electroshocker',['electroshocker','electro']),
    ('Accelerator',['accelerator','accel']),
    ('Engineer',['engineer','engi']),
    ('Commander',['commander']),
    ('Minigunner',['minigunner','mini']),
    ('Pyromancer',['pyromancer','pyro']),
    ('Shotgunner',['shotgunner']),
    ('Rocketeer',['rocketeer']),
    ('Gladiator',['gladiator']),
    ('Executioner',['executioner']),
    ('Necromancer',['necromancer']),
    ('Cryomancer',['cryomancer']),
    ('Saboteur',['saboteur']),
    ('Kingpin',['kingpin']),
    ('Enforcer',['enforcer']),
    ('Hacker',['hacker']),
    ('Ranger',['ranger']),
    ('Turret',['turret']),
    ('Mortar',['mortar']),
    ('Pursuit',['pursuit']),
    ('Medic',['medic']),
    ('Farm',['farm']),
    ('Cowboy',['cowboy']),
    ('Scout',['scout']),
    ('Soldier',['soldier']),
    ('Demoman',['demoman','demo']),
    ('Militant',['militant']),
    ('Freezer',['freezer']),
    ('Sledger',['sledger']),
    ('Swarmer',['swarmer']),
    ('Archer',['archer']),
    ('Jester',['jester']),
    ('Commando',['commando']),
    ('Slasher',['slasher']),
    ('Trapper',['trapper']),
    ('Boomerang',['boomerang']),
    ('Tesla',['tesla'])
]

def _tower_mentions(text):
    low=norm(text); found=[]
    for canonical,aliases in _LOADOUT_TOWER_ALIASES:
        best=None
        for alias in aliases:
            m=re.search(r'(?<![a-z0-9])'+re.escape(norm(alias))+r'(?![a-z0-9])',low)
            if m and (best is None or m.start()<best): best=m.start()
        if best is not None: found.append((best,canonical))
    found.sort()
    names=[]; seen=set()
    for _,name in found:
        if name not in seen:
            seen.add(name); names.append(name)
    golden_bases={x[7:] for x in names if x.startswith('Golden ')}
    return [x for x in names if not (x in golden_bases and ('Golden '+x) in names)]

def discussion_deep_search(req):
    q=str(req.get('query') or '').strip()
    pages=max(1,min(int(req.get('pages') or 2000),2000))
    per_page=max(1,min(int(req.get('per_page') or 100),100))
    must=req.get('must_include') or []
    prefer=req.get('prefer_include') or []
    strict_must=bool(req.get('strict_must_include',True))
    include_media=bool(req.get('include_media_candidates',False))
    hard_runtime_limit=210
    requested_runtime=int(req.get('max_runtime_seconds') or hard_runtime_limit)
    max_runtime=max(30,min(requested_runtime,hard_runtime_limit))
    max_errors=max(1,min(int(req.get('max_consecutive_errors') or 3),10))
    max_empty_pages=max(1,min(int(req.get('max_consecutive_empty_pages') or 3),10))
    verify_top=max(1,min(int(req.get('verify_top') or 30),50))
    default_min=len(must) if strict_must else min(len(must),max(2,len(must)-1)) if must else 0
    minimum_required=max(0,min(int(req.get('minimum_required_groups',default_min)),len(must)))

    results=[]; seen=set(); scanned=0; page_summaries=[]
    previous_fingerprint=None; repeated_pages=0; empty_pages=0; consecutive_errors=0
    started=time.monotonic(); deadline=started+max_runtime
    stop_reason='page_limit_reached'

    def remaining_timeout(cap=12):
        return max(2,min(cap,max(2,int(deadline-time.monotonic()))))

    def progress(status,page=None,error=None):
        payload={
            'status':status,'mode':'discussion_deep_search','query':q,
            'pages_requested':pages,'per_page':per_page,
            'pages_attempted':len(page_summaries),'threads_scanned':scanned,
            'matches_so_far':len(results),'runtime_seconds':round(time.monotonic()-started,2),
            'max_runtime_seconds':max_runtime,'updated_at':datetime.now(timezone.utc).isoformat()
        }
        if page is not None: payload['page']=page
        if error: payload['error']=error
        wjson('bridge_progress.json',payload)

    progress('started')
    for page in range(pages):
        if time.monotonic()>=deadline:
            stop_reason='runtime_limit'
            page_summaries.append({'page':page,'error':f'max runtime exceeded ({max_runtime}s)'})
            break
        try:
            d=get_json(WIKIA,{
                'controller':'DiscussionThread','method':'getThreads','siteId':SITE_ID,
                'limit':per_page,'page':page,'responseGroup':'full',
                'sortDirection':'descending','sortKey':'creation_date','viewableOnly':'false'
            },timeout=remaining_timeout())
        except Exception as e:
            consecutive_errors+=1
            page_summaries.append({'page':page,'error':str(e),'consecutive_errors':consecutive_errors})
            progress('endpoint_error',page+1,str(e))
            if consecutive_errors>=max_errors:
                stop_reason='endpoint_error'
                break
            continue

        consecutive_errors=0
        objs=flatten(d); roots=[]; local_seen=set()
        for o in objs:
            tid=o.get('threadId') or o.get('threadIdStr') or o.get('id')
            title=o.get('title')
            key=str(tid)+'|'+str(title)
            if key in local_seen: continue
            local_seen.add(key); roots.append(o)

        if not roots:
            empty_pages+=1
            page_summaries.append({'page':page,'objects':0,'consecutive_empty_pages':empty_pages})
            progress('running',page+1)
            if empty_pages>=max_empty_pages:
                stop_reason='archive_exhausted'
                break
            continue

        empty_pages=0
        fingerprint=hashlib.sha256('|'.join(sorted(
            str((o.get('threadId') or o.get('threadIdStr') or o.get('id')))+'::'+str(o.get('title'))
            for o in roots
        )).encode('utf-8')).hexdigest()
        if fingerprint==previous_fingerprint:
            repeated_pages+=1
            page_summaries.append({
                'page':page,'objects':len(roots),
                'error':'duplicate page payload; pagination endpoint is not advancing',
                'repeated_pages':repeated_pages
            })
            progress('pagination_stalled',page+1,'duplicate page payload')
            if repeated_pages>=2:
                stop_reason='pagination_stalled'
                break
            continue

        previous_fingerprint=fingerprint; repeated_pages=0
        scanned+=len(roots)
        page_summaries.append({'page':page,'objects':len(roots)})
        progress('running',page+1)

        for o in roots:
            blob=_deep_blob(o); low=norm(blob); media=_media_info(o)
            matched=[g for g in must if _group_hit(low,g)]
            all_required=(not must) or len(matched)==len(must)
            media_only=False
            if strict_must and not all_required: continue
            if not strict_must and must and len(matched)<minimum_required:
                if include_media and media['has_images']: media_only=True
                else: continue

            toks=[t for t in re.findall(r'[a-z0-9]+',norm(q)) if len(t)>1]
            score=sum(low.count(t) for t in toks)
            score+=sum(8 for _ in matched)
            score+=sum(3 for x in prefer if norm(x) in low)
            title_low=norm(o.get('title'))
            score+=sum(20 for x in prefer if norm(x) in title_low)
            if any(x in title_low for x in ('loadout','strategy','strat','solo','duo')): score+=60
            if any(x in title_low for x in ('tier list','tierlist','ranking','rating')): score-=50
            if media_only: score-=20

            tid=o.get('threadId') or o.get('threadIdStr') or o.get('id')
            key=str(tid)+'|'+str(o.get('title'))
            if key in seen: continue
            seen.add(key)
            mentions=_tower_mentions(blob)
            if 5<=len(mentions)<=7: score+=25
            results.append({
                'score':score,'thread_id':tid,'title':o.get('title'),
                'author':o.get('createdBy') or o.get('username') or o.get('user'),
                'snippet':strip_html(blob)[:1400],
                'url':f'{BASE}/f/p/{tid}' if str(tid).isdigit() else None,
                'matched_required_groups':matched,
                'all_required_groups_in_text':all_required,
                'media_only_candidate':media_only,
                'tower_mentions':mentions,
                **media
            })

    results.sort(key=lambda x:(-x['score'],str(x.get('title') or '')))
    verified=[]; verification_errors=0
    for item in results[:verify_top]:
        if time.monotonic()>=deadline-2:
            stop_reason='runtime_limit_during_verification'
            break
        tid=item.get('thread_id')
        if not str(tid).isdigit(): continue
        try:
            d=get_json(WIKIA,{
                'controller':'DiscussionThread','method':'getThread','threadId':str(tid),
                'limit':100,'responseGroup':'full','sortDirection':'ascending',
                'sortKey':'creation_date','viewableOnly':'false'
            },timeout=remaining_timeout())
            full=_deep_blob(d); low=norm(full); full_media=_media_info(d)
            full_matched=[g for g in must if _group_hit(low,g)]
            required_ok=(not must) or len(full_matched)>=minimum_required
            v=dict(item)
            v['full_thread_required_match']=required_ok
            v['full_thread_matched_required_groups']=full_matched
            v['full_thread_text_excerpt']=strip_html(full)[:5000]
            v['full_thread_has_images']=full_media['has_images']
            v['full_thread_image_urls']=full_media['image_urls']
            v['tower_mentions']=_tower_mentions(full)
            verified.append(v)
        except Exception as e:
            verification_errors+=1
            v=dict(item); v['verification_error']=str(e); verified.append(v)

    scanned_page_numbers=[int(x.get('page',0))+1 for x in page_summaries if 'page' in x]
    populated_page_numbers=[int(x.get('page',0))+1 for x in page_summaries if x.get('objects',0)>0 and 'error' not in x]
    empty_page_numbers=[int(x.get('page',0))+1 for x in page_summaries if x.get('objects',0)==0 and 'error' not in x]
    error_pages=[int(x.get('page',0))+1 for x in page_summaries if 'error' in x]
    pages_attempted=len(page_summaries)
    pages_completed=pages_attempted-len(error_pages)
    partial=stop_reason in {'runtime_limit','runtime_limit_during_verification','endpoint_error','pagination_stalled'}
    run_state='partial' if partial else 'completed'
    runtime=round(time.monotonic()-started,2)

    r={
        'query':q,
        'run_status':run_state,
        'stop_reason':stop_reason,
        'archive_complete':not partial,
        'runtime_seconds':runtime,
        'scope':f'Fandom discussions, up to {pages} pages x {per_page}; stops after {max_empty_pages} consecutive empty pages',
        'page_indexing':{'api_zero_based':True,'report_one_based':True},
        'pages_requested':pages,'pages_attempted':pages_attempted,'pages_completed':pages_completed,
        'pages_with_threads':len(populated_page_numbers),'pages_empty':len(empty_page_numbers),
        'pages_with_errors':len(error_pages),'scanned_page_numbers':scanned_page_numbers,
        'populated_page_numbers':populated_page_numbers,'empty_page_numbers':empty_page_numbers,
        'error_page_numbers':error_pages,'threads_scanned':scanned,
        'required_groups':must,'minimum_required_groups':minimum_required,
        'preferred_terms':prefer,'strict_must_include':strict_must,
        'include_media_candidates':include_media,'page_summaries':page_summaries,
        'matches':results[:100],'verified_top_matches':verified,
        'verification_requested':min(verify_top,len(results)),
        'verification_completed':len(verified),'verification_errors':verification_errors,
        'selection_note':'Text candidates must meet the required-group threshold. Screenshot-only candidates are labeled media_only_candidate and are never treated as text-verified.'
    }
    wjson('discussion_deep_search.json',r)
    wjson('meta.json',{
        'mode':'discussion_deep_search','requested':q,'run_status':run_state,
        'stop_reason':stop_reason,'archive_complete':not partial,'runtime_seconds':runtime,
        'threads_scanned':scanned,'match_count':len(results),
        'pages_requested':pages,'pages_attempted':pages_attempted,
        'pages_completed':pages_completed,'pages_with_threads':len(populated_page_numbers),
        'pages_empty':len(empty_page_numbers),'pages_with_errors':len(error_pages),
        'verification_completed':len(verified)
    })
    wjson('evidence_bundle.json',{'mode':'discussion_deep_search',**r})
    progress(run_state)

    report=[
        'TDS Fandom discussion deep search',
        f'Query: {q}',
        f'Status: {run_state}',
        f'Stop reason: {stop_reason}',
        f'Pages requested: {pages}',
        f'Pages attempted: {pages_attempted}',
        f'Pages with threads: {len(populated_page_numbers)}',
        f'Threads scanned: {scanned}',
        f'Matches found: {len(results)}',
        f'Full threads verified: {len(verified)}',
        f'Runtime seconds: {runtime}',
        '',
        'Top verified matches:'
    ]
    for idx,item in enumerate(verified[:20],1):
        report.append(f"{idx}. {item.get('title') or '(untitled)'}")
        if item.get('tower_mentions'): report.append('   Tower mentions: '+', '.join(item['tower_mentions']))
        if item.get('url'): report.append('   '+item['url'])
        excerpt=item.get('full_thread_text_excerpt') or item.get('snippet') or ''
        if excerpt: report.append('   '+excerpt[:350])
    if not verified: report.append('No fully verified matches were returned.')
    wtext('result.txt','\n'.join(report)+'\n')
    return 0

def recent_changes(limit=100):
    d=api({'action':'query','list':'recentchanges','rcnamespace':0,'rclimit':min(max(limit,1),500),'rcprop':'title|ids|timestamp|user|comment|sizes|flags|tags'}); ch=d.get('query',{}).get('recentchanges',[])
    wjson('recent_changes.json',ch); wjson('meta.json',{'mode':'recent_changes','count':len(ch)}); wjson('evidence_bundle.json',{'mode':'recent_changes','recent_changes':ch}); return 0

def towers_category():
    try:
        d=api({'action':'query','list':'categorymembers','cmtitle':'Category:Towers','cmnamespace':0,'cmlimit':'max'}); return {x.get('title') for x in d.get('query',{}).get('categorymembers',[]) if x.get('title')}
    except:return set()

