    if res['status']!='resolved': wjson('search_candidates.json',res.get('candidates',[])); return 2
    p,revs,_=page_bundle(res['canonical_title']); hist=[{k:r.get(k) for k in ('revid','parentid','timestamp','user','comment','size','sha1')} for r in revs]; df=diff_of(revs)
    wjson('revision_history.json',hist); wjson('revision_diff.json',df); wjson('meta.json',{'mode':'history','requested':q,'title':res['canonical_title'],'pageid':p.get('pageid')}); wjson('evidence_bundle.json',{'mode':'history','resolution':res,'revision_history':hist,'revision_diff':df}); return 0

def search_mode(q):
    alias=ALIASES.get(norm(q)); cs=search_candidates(alias or q,12); out=[]
    for c in cs:
        c=dict(c)
        try:
            p,_,wt=page_bundle(c['title']); pm=parse_meta(c['title']); c['classification']=classify(wt,p.get('categories',[]),pm.get('templates',[]))
        except Exception as e:c['validation_error']=str(e)
        out.append(c)
    wjson('search_candidates.json',out); wjson('meta.json',{'mode':'search','requested':q,'known_alias_target':alias,'selection_policy':'No fuzzy candidate is ever auto-selected.'}); wjson('evidence_bundle.json',{'mode':'search','requested':q,'known_alias_target':alias,'candidates':out}); return 0

def collect(obj,depth=0):
    if depth>14:return []
    out=[]
    if isinstance(obj,dict):
        for k,v in obj.items():
            if norm(k) in {'title','rawcontent','content','text','username','name','id','threadid'} and isinstance(v,(str,int,float)): out.append(f'{k}: {v}')
            else: out+=collect(v,depth+1)
    elif isinstance(obj,list):
        for v in obj: out+=collect(v,depth+1)
    return out

def discussion(url):
    m=re.search(r'/f/p/(\d+)',url or '')
    if not m: raise ValueError('thread_url must contain /f/p/<threadId>')
    tid=m.group(1); d=get_json(WIKIA,{'controller':'DiscussionThread','method':'getThread','threadId':tid,'limit':100,'responseGroup':'full','sortDirection':'ascending','sortKey':'creation_date','viewableOnly':'false'})
    wtext('discussion_json.txt',json.dumps(d,ensure_ascii=False,indent=2)); wtext('discussion_text.txt','\n'.join(collect(d))); wjson('meta.json',{'mode':'discussion','thread_url':url,'thread_id':tid}); wjson('evidence_bundle.json',{'mode':'discussion','thread_url':url,'thread_id':tid,'discussion':d}); return 0

def flatten(obj,out=None,depth=0):
    out=[] if out is None else out
    if depth>12:return out
    if isinstance(obj,dict):
        tf=[v for k,v in obj.items() if norm(k) in {'title','rawcontent','content','text','body'} and isinstance(v,str)]
        if tf and any(k in obj for k in ('id','threadId','threadIdStr','title')): out.append(obj)
        for v in obj.values(): flatten(v,out,depth+1)
    elif isinstance(obj,list):
        for v in obj: flatten(v,out,depth+1)
    return out

def discussion_search(q,limit=100):
    try:d=get_json(WIKIA,{'controller':'DiscussionThread','method':'getThreads','siteId':SITE_ID,'limit':min(max(limit,1),100),'responseGroup':'full','sortDirection':'descending','sortKey':'creation_date','viewableOnly':'false'})
    except Exception as e:
        r={'query':q,'error':str(e),'matches':[],'scope':'recent discussions endpoint'}; wjson('discussion_search.json',r); wjson('meta.json',{'mode':'discussion_search','requested':q,'status':'endpoint_error'}); wjson('evidence_bundle.json',{'mode':'discussion_search',**r}); return 1
    wjson('discussion_recent_raw.json',d)
    toks=[t for t in re.findall(r'[a-z0-9]+',norm(q)) if len(t)>1]; matches=[]; seen=set()
    for o in flatten(d):
        blob=' '.join(str(o.get(k,'')) for k in ('title','rawContent','content','text','body')); low=norm(blob); score=sum(low.count(t) for t in toks)
        if not score: continue
        tid=o.get('threadId') or o.get('threadIdStr') or o.get('id'); key=str(tid)+'|'+str(o.get('title'))
        if key in seen: continue
        seen.add(key); matches.append({'score':score,'thread_id':tid,'title':o.get('title'),'author':o.get('createdBy') or o.get('username') or o.get('user'),'snippet':strip_html(blob)[:700],'url':f'{BASE}/f/p/{tid}' if str(tid).isdigit() else None})
    matches.sort(key=lambda x:(-x['score'],str(x.get('title') or ''))); r={'query':q,'scope':f'latest {min(max(limit,1),100)} discussions returned by Fandom getThreads','warning':'Not an unlimited historical full-text index; searches the discussions Fandom returned.','matches':matches[:30]}
    wjson('discussion_search.json',r); wjson('meta.json',{'mode':'discussion_search','requested':q,'match_count':len(r['matches'])}); wjson('evidence_bundle.json',{'mode':'discussion_search',**r}); return 0


def _deep_blob(o):
    vals=[]
    for k in ('title','rawContent','content','text','body','description'):
        v=o.get(k) if isinstance(o,dict) else None
        if isinstance(v,str): vals.append(v)
    return ' '.join(vals)

def _group_hit(low, group):
    if isinstance(group,str): group=[group]
    return any(norm(alias) in low for alias in group if str(alias).strip())

def discussion_deep_search(req):
    q=str(req.get('query') or '').strip()
    pages=max(1,min(int(req.get('pages') or 20),50))
    per_page=max(1,min(int(req.get('per_page') or 1000),1000))
    must=req.get('must_include') or []
    prefer=req.get('prefer_include') or []
    results=[]; seen=set(); scanned=0; page_summaries=[]
    for page in range(pages):
        try:
            d=get_json(WIKIA,{
                'controller':'DiscussionThread','method':'getThreads','siteId':SITE_ID,
                'limit':per_page,'page':page,'responseGroup':'full',
                'sortDirection':'descending','sortKey':'creation_date','viewableOnly':'false'
            })
        except Exception as e:
            page_summaries.append({'page':page,'error':str(e)})
            break
        objs=flatten(d)
        roots=[]; local_seen=set()
        for o in objs:
            tid=o.get('threadId') or o.get('threadIdStr') or o.get('id')
            title=o.get('title')
            key=str(tid)+'|'+str(title)
            if key in local_seen: continue
            local_seen.add(key); roots.append(o)
        scanned+=len(roots)
        page_summaries.append({'page':page,'objects':len(roots)})
        if not roots: break
        for o in roots:
            blob=_deep_blob(o); low=norm(blob)
            if must and not all(_group_hit(low,g) for g in must): continue
            toks=[t for t in re.findall(r'[a-z0-9]+',norm(q)) if len(t)>1]
            score=sum(low.count(t) for t in toks)
            score+=sum(8 for g in must if _group_hit(low,g))
            score+=sum(3 for x in prefer if norm(x) in low)
            tid=o.get('threadId') or o.get('threadIdStr') or o.get('id')
            key=str(tid)+'|'+str(o.get('title'))
            if key in seen: continue
            seen.add(key)
            results.append({
                'score':score,'thread_id':tid,'title':o.get('title'),
                'author':o.get('createdBy') or o.get('username') or o.get('user'),
                'snippet':strip_html(blob)[:1400],
                'url':f'{BASE}/f/p/{tid}' if str(tid).isdigit() else None,
                'matched_required_groups':[g for g in must if _group_hit(low,g)]
            })
        if len(roots)<per_page: break
    results.sort(key=lambda x:(-x['score'],str(x.get('title') or '')))
    # Verify the strongest candidates by fetching their full threads/replies.
    verified=[]
    for item in results[:25]:
        tid=item.get('thread_id')
        if not str(tid).isdigit(): continue
        try:
            d=get_json(WIKIA,{
                'controller':'DiscussionThread','method':'getThread','threadId':str(tid),
                'limit':100,'responseGroup':'full','sortDirection':'ascending',
                'sortKey':'creation_date','viewableOnly':'false'
            })
            full=' '.join(collect(d)); low=norm(full)
            required_ok=(not must) or all(_group_hit(low,g) for g in must)
            v=dict(item); v['full_thread_required_match']=required_ok
            v['full_thread_text_excerpt']=strip_html(full)[:5000]
            verified.append(v)
        except Exception as e:
            v=dict(item); v['verification_error']=str(e); verified.append(v)
    r={
        'query':q,
        'scope':f'up to {pages*per_page} Fandom discussion threads ({pages} pages x {per_page})',
        'threads_scanned':scanned,
        'required_groups':must,
        'preferred_terms':prefer,
        'page_summaries':page_summaries,
        'matches':results[:100],
        'verified_top_matches':verified,
        'selection_note':'Required groups must all appear before a thread is included; top candidates are then checked using the full thread and replies.'
    }
    wjson('discussion_deep_search.json',r)
    wjson('meta.json',{'mode':'discussion_deep_search','requested':q,'threads_scanned':scanned,'match_count':len(results)})
    wjson('evidence_bundle.json',{'mode':'discussion_deep_search',**r})
    return 0

def recent_changes(limit=100):
    d=api({'action':'query','list':'recentchanges','rcnamespace':0,'rclimit':min(max(limit,1),500),'rcprop':'title|ids|timestamp|user|comment|sizes|flags|tags'}); ch=d.get('query',{}).get('recentchanges',[])
    wjson('recent_changes.json',ch); wjson('meta.json',{'mode':'recent_changes','count':len(ch)}); wjson('evidence_bundle.json',{'mode':'recent_changes','recent_changes':ch}); return 0

def towers_category():
    try:
        d=api({'action':'query','list':'categorymembers','cmtitle':'Category:Towers','cmnamespace':0,'cmlimit':'max'}); return {x.get('title') for x in d.get('query',{}).get('categorymembers',[]) if x.get('title')}
    except:return set()

