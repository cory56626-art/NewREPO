{
  "priority_rule": {
    "rule": "For TDS tower disagreements, prefer {{Upgrade}} blocks and ==Description== over stale summary/infobox tables.",
    "priority": [
      "upgrade_templates",
      "description",
      "infobox_or_summary"
    ]
  },
  "potential_conflicts": [
    {
      "mode": "regular",
      "level": 1,
      "field": "tick",
      "upgrade_claim": 0.15,
      "statistics_table_claim": 3.0,
      "preferred_source": "upgrade_template",
      "type": "set_mismatch",
      "claim_text": "0.175 > 0.15 Firerate"
    },
    {
      "mode": "pvp",
      "level": 1,
      "field": "tick",
      "upgrade_claim": 0.12,
      "statistics_table_claim": 6.0,
      "preferred_source": "upgrade_template",
      "type": "set_mismatch",
      "claim_text": "0.15 > 0.12 Firerate"
    },
    {
      "mode": "pvp",
      "level": 4,
      "field": "tick",
      "upgrade_claim": 0.1,
      "statistics_table_claim": 10.0,
      "preferred_source": "upgrade_template",
      "type": "set_mismatch",
      "claim_text": "0.12 > 0.1 Firerate"
    },
    {
      "mode": "regular",
      "level": 0,
      "field": "tick",
      "infobox_claim": 0.175,
      "statistics_table_claim": 3.0,
      "preferred_source": "infobox_or_description_only_if_no_upgrade_claim",
      "type": "base_summary_mismatch"
    },
    {
      "mode": "pvp",
      "level": 0,
      "field": "tick",
      "infobox_claim": 0.15,
      "statistics_table_claim": 4.0,
      "preferred_source": "infobox_or_description_only_if_no_upgrade_claim",
      "type": "base_summary_mismatch"
    }
  ],
  "notes": [
    "Different upgrade levels can legitimately differ.",
    "When a current-level Upgrade claim disagrees with the Statistics table, the configured rule prefers Upgrade/Description and flags the mismatch rather than silently choosing."
  ]
}
